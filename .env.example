# Database (CI creates root role via scripts/postgres-ci-init.sql and uses postgresql://root:root@localhost:5432/ci?schema=public)
DATABASE_URL="postgresql://user:password@localhost:5432/flixcam_rent?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth.js (required for login/session – if missing, sign-in can fail)
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_SECRET="" # Alias for NEXTAUTH_SECRET (used by some auth libs)
# NEXTAUTH_URL must match the app URL including port. If using "next dev -p 3001", use:
NEXTAUTH_URL="http://localhost:3000"
# If admin login fails with "wrong password or email", run: npm run db:seed (or npx tsx scripts/reset-admin-password.ts)

# Google OAuth (Sign in with Google) — from Google Cloud Console OAuth 2.0 Client (Web application)
# Add authorized redirect URI: https://yourdomain.com/api/auth/callback/google (and http://localhost:3000/... for local)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cron jobs (e.g. nightly backfill) — required for /api/cron/*
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Optional: user id for cron-initiated booking transitions (defaults to first ADMIN)
# CRON_ACTOR_USER_ID=""
# Retention for SMS/WhatsApp logs and OTP cleanup (days, default 60)
# SMS_OTP_RETENTION_DAYS=60
# Abandoned cart/session cleanup threshold (days, default 7)
# SESSION_RETENTION_DAYS=7
# PDPL audit log archive threshold (days, default 90)
# PDPL_ARCHIVE_DAYS=90
# PDPL_ARCHIVE_DIR=/var/backups/flixcam/pdpl

# DB backup retention (daily cron at 03:00)
# BACKUP_DIR=/home/flixcam.rent/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_VERIFY_LATEST=true
# Off-server copy (optional): BACKUP_REMOTE_HOST=user@host BACKUP_REMOTE_PATH=/backups/flixcam
# Or local mirror only: BACKUP_REMOTE_PATH=/backup/flixcam-db

# Equipment photos live on disk (not in git); ~1.6GB on VPS
# PUBLIC_UPLOADS_PATH=public/photos

# Notifications: bullmq (default when REDIS_URL set) or memory
# NOTIFICATION_QUEUE_MODE=bullmq
# NOTIFICATION_WORKER_CONCURRENCY=5

# GA4 server-side sync (Measurement Protocol)
# GA4_MEASUREMENT_API_SECRET=""

# External uptime monitor webhook
# UPTIME_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Health watchdog: auto git pull + build on 2nd failure in same hour
# WATCHDOG_AUTO_DEPLOY=false

# Phase 6 — Cron alerts
# SLACK_WEBHOOK_URL=
# DLQ_ALERT_THRESHOLD=10

# Phase 8 — Finance automation
# AUTO_REFUND_POLICY_HOURS=48
# WALLET_AUTO_APPROVE_PAYOUTS=false
# LOW_STOCK_THRESHOLD=2

# ZATCA Fatoora clearance (optional API — TLV QR works without)
# ZATCA_API_URL=
# ZATCA_API_KEY=
# ZATCA_COMPANY_NAME=
# ZATCA_COMPANY_VAT=

# Phase 9 — Infrastructure
# BULLMQ_REDIS_URL=redis://localhost:6379/1
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT= (R2: https://<account>.r2.cloudflarestorage.com)
# R2_BUCKET= / R2_ENDPOINT= / R2_PUBLIC_URL= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY=

# Blog preview mode (draft posts with ?preview=true&token=xxx)
BLOG_PREVIEW_TOKEN=""
# Optional: separate secret for blog revalidation webhook (falls back to CRON_SECRET)
REVALIDATE_BLOG_SECRET=""

# Tap Payments (also used by Payment gateways admin when Tap is enabled)
TAP_API_KEY=your-tap-key
# TAP_API_URL="https://api.tap.company/v2" # Optional override
TAP_SECRET_KEY="sk_test_..."
TAP_PUBLIC_KEY="pk_test_..."
TAP_WEBHOOK_SECRET="whsec_..."

# Payment gateways (optional – can be set per gateway in Admin → Settings → Payment gateways)
# Leave empty to configure via admin panel; when set here, values are used as fallback.
# Tap (see above): TAP_SECRET_KEY, TAP_PUBLIC_KEY, TAP_WEBHOOK_SECRET
# Moyasar
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
MOYASAR_ROLLOUT_ENABLED="true"
MOYASAR_ROLLOUT_PERCENT="100"
PAYMENT_DEFAULT_GATEWAY="moyasar"
# MyFatoorah
MYFATOORAH_API_KEY=""
MYFATOORAH_WEBHOOK_SECRET=""
# Tamara (BNPL)
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
TAMARA_PUBLIC_KEY=""
# Tabby (BNPL)
TABBY_SECRET_KEY=""
TABBY_PUBLIC_KEY=""
# PayTabs
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
# HyperPay
HYPERPAY_ENTITY_ID=""
HYPERPAY_ACCESS_TOKEN=""
# Geidea
GEIDEA_PUBLIC_KEY=""
GEIDEA_API_PASSWORD=""

# ── Transactional email (required for contact form, booking emails, etc.) ─────
# Option A — Resend (recommended): https://resend.com — create API key, verify sending domain.
# Paste the full key in your real .env (never commit .env). Leave empty locally if you do not send mail.
RESEND_API_KEY=""
# Must be an address/domain you verified in Resend (or Resend will reject sends).
RESEND_FROM="no-reply@flixcam.rent"
RESEND_FROM_NAME="FlixCam.rent"
#
# Option B — SMTP fallback (if RESEND_API_KEY is unset and code path uses SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@flixcam.rent"
SMTP_FROM_NAME="FlixCam.rent"

# Additional recipients for "order completed" (payment confirmed) staff email notifications.
# Comma-separated list. Example: "owner@example.com,ops@example.com"
ORDER_COMPLETED_NOTIFY_EMAILS=""

# Email Configuration (Gmail OAuth - Alternative)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Email Configuration (Hotmail/Outlook - Alternative)
HOTMAIL_CLIENT_ID=""
HOTMAIL_CLIENT_SECRET=""
HOTMAIL_REFRESH_TOKEN=""

# WhatsApp Cloud API (access token used for Graph API authentication)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
# Optional: approved Twilio Content Template SID for password reset links over WhatsApp.
# Without this, forgot-password falls back to SMS instead of reusing the OTP template.
TWILIO_WHATSAPP_PASSWORD_RESET_CONTENT_SID=""
# Optional: Twilio Content Template SID for OTP codes over WhatsApp (defaults to a built-in SID if unset).
TWILIO_WHATSAPP_OTP_CONTENT_SID=""
# OTP order: set "true" for WhatsApp before SMS; "false" to force SMS before WhatsApp.
# If unset: WhatsApp is tried first when TWILIO_WHATSAPP_PHONE_NUMBER is set but TWILIO_SMS_PHONE_NUMBER is not (avoids Twilio 21659 from a non-SMS-capable TWILIO_PHONE_NUMBER).
OTP_TRY_WHATSAPP_FIRST=""
# ENABLE_WHATSAPP="false"  # Set to "true" to send WhatsApp messages (see also Messaging Center in CMS)

# SMS (Twilio) - Required for OTP during registration and resend
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# SMS sender must be a number YOU OWN in Twilio Console (Phone Numbers).
TWILIO_SMS_PHONE_NUMBER=""
#
# WhatsApp sender must be a Twilio WhatsApp sender (Sandbox: whatsapp:+14155238886) or your approved WhatsApp sender.
TWILIO_WHATSAPP_PHONE_NUMBER=""
# Legacy alias read by runtime fallback.
TWILIO_WHATSAPP_NUMBER=""
#
# Backward-compat fallback (legacy). If you set this, it will be used for SMS and WhatsApp unless the channel-specific vars above are set.
TWILIO_PHONE_NUMBER=""
ENABLE_SMS="true"  # Set to "true" to send SMS. Used for OTP (register) and forgot-password.

# ── Marketing & SEO (public NEXT_PUBLIC_* + server secrets) ─────────────────
# Run: npx prisma migrate deploy (creates MarketingSettings, MarketingEvent, newsletter fields)
NEXT_PUBLIC_SITE_URL="https://flixcam.rent"
NEXT_PUBLIC_SITE_NAME="FlixCam"
NEXT_PUBLIC_SITE_NAME_AR="فليكس كام"
NEXT_PUBLIC_OG_IMAGE_DEFAULT="https://flixcam.rent/og-default.jpg"
NEXT_PUBLIC_BUSINESS_LOGO="https://flixcam.rent/logo.png"
NEXT_PUBLIC_BUSINESS_PHONE="+966XXXXXXXXX"
NEXT_PUBLIC_BUSINESS_EMAIL="info@flixcam.rent"
NEXT_PUBLIC_WHATSAPP_NUMBER="966XXXXXXXXX"
NEXT_PUBLIC_BUSINESS_ADDRESS_STREET=""
NEXT_PUBLIC_BUSINESS_ADDRESS_CITY="Riyadh"
NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY="SA"
# FlixCam Rent studio (Riyadh) — match Google Maps place for /contact embed + schema
NEXT_PUBLIC_BUSINESS_LAT="24.7586131"
NEXT_PUBLIC_BUSINESS_LNG="46.716979"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Maps Embed API (Google Cloud): enable "Maps Embed API", restrict key by HTTP referrer (your domain).
# Required for the iframe map on /contact. https://developers.google.com/maps/documentation/embed/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=""
# Google Maps JavaScript API key used by checkout map components.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_TWITTER_HANDLE="@FlixCam"
NEXT_PUBLIC_TWITTER_SITE="@FlixCam"
NEXT_PUBLIC_GTM_CONTAINER_ID=""
# When "true", dataLayer pushes wait for cookie Accept. When unset/false, fire always (use GTM Consent Mode for compliance).
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
# Backward-compatible GA key used by public layout.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=""
NEXT_PUBLIC_PINTEREST_TAG_ID=""
NEXT_PUBLIC_TWITTER_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
GOOGLE_ADS_CONVERSION_ID=""
GOOGLE_ADS_CONVERSION_LABEL=""
META_CONVERSIONS_API_TOKEN=""
META_CONVERSIONS_API_TEST_EVENT_CODE=""
# POST /api/meta-conversions: header x-meta-capi-key must match (or use CRON_SECRET)
MARKETING_CAPI_ROUTE_SECRET=""
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""
MAILCHIMP_SERVER_PREFIX="us1"
# Legacy aliases (optional; code also reads NEXT_PUBLIC_* above)
GTM_CONTAINER_ID=""
GA4_MEASUREMENT_ID=""
META_PIXEL_ID=""

# OpenAI (Phase 2 - AI Features)
OPENAI_API_KEY=""

# OpenAI Embeddings (for recommendAlternatives similarity)
# Default: text-embedding-ada-002
OPENAI_EMBEDDINGS_MODEL="text-embedding-ada-002"

# Google Gemini (Phase 2 - AI Features - Alternative)
GEMINI_API_KEY=""
# Alternative env name for Gemini (some SDKs use this)
GOOGLE_GENERATIVE_AI_API_KEY=""

# AI Provider Selection (for bulk import autofill, AI preview, equipment autofill)
# Options: "openai" or "gemini" — set the key for your chosen provider above
AI_PROVIDER="gemini"

# AI pricing seasonality factor (optional; default 1.0)
# AI_SEASONALITY_FACTOR="1.0"

# Pexels (image sourcing pipeline - free API key from pexels.com)
PEXELS_API_KEY=""

# Unsplash (image sourcing pipeline - free tier: 50 req/hr)
UNSPLASH_APPLICATION_ID=""
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# Google Custom Search Images (image sourcing - free tier: 100 queries/day)
GOOGLE_CUSTOM_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# Pricing multipliers (optional; defaults: weekly 4, monthly 12)
# PRICING_WEEKLY_FACTOR="4"
# PRICING_MONTHLY_FACTOR="12"

# AI model override (default: gpt-4o-mini)
# AI_MODEL="gpt-4o-mini"

# Contact & Social (public)
# NEXT_PUBLIC_WHATSAPP_NUMBER="966500000000"
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"
# NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@yourhandle"
# NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/yourpage"

# Backfill worker: concurrency (default 10) and delay between batches in ms (default 500)
BACKFILL_CONCURRENCY="10"
BACKFILL_RATE_LIMIT_MS="500"

# AI cost guardrails (optional; also configurable in Admin > Settings > AI)
# AI_DAILY_BUDGET_USD="50"
# AI_MONTHLY_BUDGET_USD="500"

# Redis (for rate limiting, caching, and BullMQ job queues)
REDIS_URL="redis://localhost:6379"

# RBAC - Use new DB-driven permission system (Phase 11 rollout)
# Set to "true" to enable new RBAC with roles/permissions from database
# Default: false (uses legacy enum-based User.role)
USE_NEW_RBAC="false"

# Cloudinary (for image processing in bulk imports)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# File Storage (Phase 1: Local, Phase 2: Cloud)
STORAGE_TYPE="local"
# For cloud storage (Phase 2):
# STORAGE_TYPE="s3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""

# ZATCA
ZATCA_API_URL=https://api.zatca.gov.sa
# ZATCA_COMPANY_NAME="" # Optional override for seller name
ZATCA_API_KEY=your-zatca-key
ZATCA_COMPANY_VAT=300012345600003
ZATCA_COMPANY_CR=1010123456

# Application
APP_ENV="development"
# NEXT_PUBLIC_AI_WIDGET_ENABLED="false" # Enable AI floating widget in admin
APP_URL="http://localhost:3000"
APP_NAME="FlixCam.rent"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (can be overridden in database)
ENABLE_BOOKING_CHECKOUT="true"
ENABLE_TEST_AUTH="" # Allow test auth endpoints in production (dev only)
ENABLE_PAYMENTS="true"
ENABLE_WHATSAPP="false"
ENABLE_AI_RECOMMENDATIONS="false"

# Rate Limiting
RATE_LIMIT_API_REQUESTS_PER_HOUR="100"
RATE_LIMIT_AUTH_ATTEMPTS_PER_15MIN="10"

# Upstash Redis (optional - for rate limiting and caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (Phase 0.4 - Error tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Security
ALLOWED_ORIGINS="http://localhost:3000,https://flixcam.rent"
# ENCRYPTION_KEY="" # Required for integration config encryption (32 bytes hex)

# Next.js
NEXT_IGNORE_INCORRECT_LOCKFILE=true

# Logging
LOG_LEVEL="info"
ENABLE_AUDIT_LOGGING="true"

# Web Research (Phase 7 - Live Specs Crawler)
# Google Custom Search API for finding product pages
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""
# Scraping proxy service (optional - for bypassing bot detection)
# Supported: "direct" (no proxy), "scrapingbee", "brightdata"
SCRAPING_SERVICE="direct"
SCRAPING_API_KEY=""
# Rate limiting between scrape requests (ms) — mimics human behavior
RESEARCH_RATE_LIMIT_DELAY="2000"

# Blog reactions / views anonymous salt (used for fingerprinting without PII)
REACTIONS_SALT=""
VIEWS_SALT=""

# First production seed only (blocked by default in production):
# ALLOW_SEED_IN_PRODUCTION="true"

# Public contact info (footer / header / contact page). Shown to visitors; not secret.
NEXT_PUBLIC_CONTACT_EMAIL="info@flixcam.rent"
NEXT_PUBLIC_CONTACT_PHONE="+966508020033"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
# Inbox for POST /api/public/contact (server-only). Same as above unless you want form mail elsewhere.
CONTACT_FORM_TO="info@flixcam.rent"

# Google Analytics (client-side, alternative to GTM_CONTAINER_ID)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Encryption key for API key storage in database (32 bytes hex)
ENCRYPTION_KEY=""

