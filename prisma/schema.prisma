generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

model Product {
  id                  String               @id @default(cuid())
  status              ProductStatus        @default(DRAFT)
  productType         ProductType          @default(RENTAL)
  sku                 String?              @unique
  brandId             String
  categoryId          String
  subCategoryId       String?
  quantity            Int?
  priceDaily          Decimal              @db.Decimal(10, 2)
  priceWeekly         Decimal?             @db.Decimal(10, 2)
  priceMonthly        Decimal?             @db.Decimal(10, 2)
  depositAmount       Decimal?             @db.Decimal(10, 2)
  bufferTime          Int                  @default(0)
  boxContents         String?
  featuredImage       String
  galleryImages       Json?
  videoUrl            String?
  relatedProducts     Json?
  tags                String?
  createdAt           DateTime             @default(now())
  createdBy           String?
  updatedAt           DateTime             @updatedAt
  updatedBy           String?
  deletedAt           DateTime?
  deletedBy           String?
  aiContentFlags      Json?
  aiReviewReason      String?
  aiRunCount          Int                  @default(0)
  contentQualityScore Int?
  contentScore        Int?
  contentScoreAt      DateTime?
  lastAiRunAt         DateTime?
  needsAiReview       Boolean              @default(false)
  photoStatus         String?              @default("unknown")
  aiContentDrafts     AiContentDraft[]
  equipment           Equipment?
  inventoryItems      InventoryItem[]
  brand               Brand                @relation(fields: [brandId], references: [id])
  category            Category             @relation("ProductCategory", fields: [categoryId], references: [id])
  subCategory         Category?            @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  productImages       ProductImage[]
  translations        ProductTranslation[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([deletedAt])
}

model ProductImage {
  id                 String      @id @default(cuid())
  productId          String
  url                String
  imageSource        ImageSource @default(UPLOAD)
  pendingReview      Boolean     @default(false)
  qualityScore       Float?
  reviewedAt         DateTime?
  reviewedBy         String?
  isDeleted          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  sortOrder          Int         @default(0)
  isPrimary          Boolean     @default(false)
  sourceQuery        String?
  sourceDomain       String?
  matchScore         Float?
  scoreBreakdown     Json?
  reviewReason       String?
  rejectionReason    String?
  cloudinaryPublicId String?
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([pendingReview])
  @@index([imageSource])
}

model ProductTranslation {
  id               String            @id @default(cuid())
  productId        String
  locale           TranslationLocale
  name             String
  shortDescription String
  longDescription  String
  specifications   Json?
  seoTitle         String
  seoDescription   String
  seoKeywords      String
  createdAt        DateTime          @default(now())
  createdBy        String?
  updatedAt        DateTime          @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@index([deletedAt])
}

model InventoryItem {
  id              String              @id @default(cuid())
  parentProductId String
  serialNumber    String              @unique
  barcode         String              @unique
  itemStatus      InventoryItemStatus @default(AVAILABLE)
  location        String?
  purchaseDate    DateTime?
  purchasePrice   Decimal?            @db.Decimal(10, 2)
  createdAt       DateTime            @default(now())
  createdBy       String?
  updatedAt       DateTime            @updatedAt
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  product         Product             @relation(fields: [parentProductId], references: [id], onDelete: Cascade)

  @@index([parentProductId])
  @@index([itemStatus])
  @@index([deletedAt])
}

model ImportJob {
  id                    String            @id @default(cuid())
  filename              String
  mimeType              String
  status                ImportJobStatus   @default(PENDING)
  totalRows             Int               @default(0)
  processedRows         Int               @default(0)
  successRows           Int               @default(0)
  errorRows             Int               @default(0)
  skippedRows           Int               @default(0)
  errorMessage          String?
  aiProcessingStatus    String?
  imageProcessingStatus String?
  selectedSheets        Json?
  selectedRows          Json?
  createdAt             DateTime          @default(now())
  createdBy             String?
  updatedAt             DateTime          @updatedAt
  updatedBy             String?
  columnMappingsBySheet Json?
  aiProcessingJobs      AIProcessingJob[]
  rows                  ImportJobRow[]
}

model ImportJobRow {
  id        String          @id @default(cuid())
  jobId     String
  rowNumber Int
  status    ImportRowStatus @default(PENDING)
  error     String?
  productId String?
  payload   Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  job       ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

model AIProcessingJob {
  id             String    @id @default(cuid())
  importJobId    String
  status         String
  provider       String
  totalItems     Int
  processedItems Int       @default(0)
  failedItems    Int       @default(0)
  cost           Decimal?  @db.Decimal(10, 4)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  importJob      ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([status])
}

model AISettings {
  id                  String    @id @default(cuid())
  provider            String    @unique
  apiKey              String
  batchSize           Int       @default(50)
  timeout             Int       @default(30000)
  fallbackStrategy    String    @default("mark_for_review")
  enabled             Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  backfillEnabled     Boolean   @default(true)
  currentDailySpend   Decimal?  @default(0) @db.Decimal(10, 4)
  currentMonthlySpend Decimal?  @default(0) @db.Decimal(10, 4)
  dailyBudgetUsd      Decimal?  @db.Decimal(10, 2)
  monthlyBudgetUsd    Decimal?  @db.Decimal(10, 2)
  monthlyResetDate    DateTime?
  nightlyCronEnabled  Boolean   @default(true)
  nightlyCronTime     String?   @default("02:00")
  spendResetDate      DateTime?

  @@index([enabled])
}

model AiJob {
  id          String      @id @default(cuid())
  type        AiJobType
  status      JobStatus   @default(PENDING)
  triggeredBy String
  triggeredAt DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  totalItems  Int         @default(0)
  processed   Int         @default(0)
  succeeded   Int         @default(0)
  failed      Int         @default(0)
  skipped     Int         @default(0)
  costUsd     Float       @default(0)
  errorLog    Json?
  metadata    Json?
  items       AiJobItem[]

  @@index([status])
  @@index([type])
  @@index([triggeredAt])
}

model AiJobItem {
  id            String    @id @default(cuid())
  jobId         String
  productId     String
  itemType      String
  status        String    @default("pending")
  error         String?
  costIncurred  Float?
  provider      String?
  fieldsUpdated Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  job           AiJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([productId])
  @@index([status])
}

model AiAuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AiContentDraft {
  id            String    @id @default(cuid())
  productId     String
  type          String
  suggestedData Json
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model CatalogQualitySnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique
  avgScore      Float
  totalProducts Int
  gapCounts     Json

  @@index([date])
}

model AiDailyCost {
  id       String   @id @default(cuid())
  date     DateTime
  feature  String
  costUsd  Float    @default(0)
  jobCount Int      @default(0)

  @@unique([date, feature])
  @@index([date])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  phone                   String?                  @unique
  phoneVerified           Boolean                  @default(false)
  role                    UserRole                 @default(CUSTOMER)
  status                  UserStatus               @default(PENDING)
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  segmentId               String?
  verificationStatus      VerificationStatus       @default(UNVERIFIED)
  createdAt               DateTime                 @default(now())
  createdBy               String?
  updatedAt               DateTime                 @updatedAt
  updatedBy               String?
  deletedAt               DateTime?
  deletedBy               String?
  taxId                   String?
  companyName             String?
  billingAddress          String?
  creditLimit             Decimal?                 @db.Decimal(12, 2)
  isBlacklisted           Boolean                  @default(false)
  blacklistReason         String?
  blacklistedAt           DateTime?
  blacklistedBy           String?
  twoFactorVerifiedAt     DateTime?
  twoFactorBackupCodes    Json?
  whatsappOptIn           Boolean                  @default(false)
  whatsappOptInAt         DateTime?
  userRoles               AssignedUserRole[]
  auditLogs               AuditLog[]
  authTokens              AuthToken[]
  phoneVerifications      PhoneVerification[]
  createdBookings         Booking[]                @relation("CreatedBookings")
  bookings                Booking[]                @relation("CustomerBookings")
  bookingRequests         BookingRequest[]         @relation("BookingRequests")
  campaigns               Campaign[]
  cart                    Cart?
  damageClaimsReported    DamageClaim[]
  damageClaimsResolved    DamageClaim[]            @relation("ResolvedDamageClaims")
  deliveries              Delivery[]
  events                  Event[]
  invoices                Invoice[]
  maintenance             Maintenance[]            @relation("MaintenanceTechnician")
  notificationPreferences NotificationPreference[]
  createdPricingRules     PricingRule[]
  promissoryNotesAsDebtor PromissoryNote[]
  quotes                  Quote[]
  receivers               Receiver[]
  recurringSeries         RecurringSeries[]
  reviews                 Review[]
  savedEquipment          SavedEquipment[]
  segment                 CustomerSegment?         @relation(fields: [segmentId], references: [id])
  permissions             UserPermission[]
  vendor                  Vendor?
  verificationDocuments   VerificationDocument[]
  referrals               Referral[]
  warehouseScans          WarehouseScan[]
  waitlistEntries         WaitlistEntry[]
  deviceTokens            DeviceToken[]
  pushSubscriptions       PushSubscription[]
  managedWarehouses       Warehouse[]              @relation("WarehouseManager")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([segmentId])
  @@index([verificationStatus])
  @@index([deletedAt])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  otpCode   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedEquipment {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
  @@index([userId])
  @@index([equipmentId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PermissionCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  nameAr      String?
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@index([sortOrder])
}

model Permission {
  id                  String               @id @default(cuid())
  name                String               @unique
  description         String?
  descriptionAr       String?
  categoryId          String?
  isSystem            Boolean              @default(false)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  createdBy           String?
  updatedAt           DateTime             @updatedAt
  updatedBy           String?
  deletedAt           DateTime?
  deletedBy           String?
  menuItemPermissions MenuItemPermission[]
  category            PermissionCategory?  @relation(fields: [categoryId], references: [id])
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  @@index([name])
  @@index([categoryId])
  @@index([deletedAt])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  createdBy    String?
  updatedAt    DateTime   @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([deletedAt])
}

model Role {
  id              String             @id @default(cuid())
  name            String             @unique
  displayName     String
  displayNameAr   String?
  description     String?
  descriptionAr   String?
  isSystem        Boolean            @default(false)
  isDefault       Boolean            @default(false)
  priority        Int                @default(0)
  color           String?
  createdAt       DateTime           @default(now())
  createdBy       String?
  updatedAt       DateTime           @updatedAt
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?
  userRoles       AssignedUserRole[]
  roleConflictsA  RoleConflict[]     @relation("RoleConflictA")
  roleConflictsB  RoleConflict[]     @relation("RoleConflictB")
  rolePermissions RolePermission[]

  @@index([name])
  @@index([isSystem])
  @@index([deletedAt])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  createdBy    String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AssignedUserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  isPrimary  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  assignedBy String?
  expiresAt  DateTime?
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RoleConflict {
  id        String   @id @default(cuid())
  roleAId   String
  roleBId   String
  reason    String
  createdAt DateTime @default(now())
  roleA     Role     @relation("RoleConflictA", fields: [roleAId], references: [id], onDelete: Cascade)
  roleB     Role     @relation("RoleConflictB", fields: [roleBId], references: [id], onDelete: Cascade)

  @@unique([roleAId, roleBId])
  @@index([roleAId])
  @@index([roleBId])
}

model MenuItem {
  id                     String               @id @default(cuid())
  parentId               String?
  name                   String               @unique
  label                  String
  labelAr                String?
  icon                   String?
  href                   String?
  sortOrder              Int                  @default(0)
  isActive               Boolean              @default(true)
  requiresAllPermissions Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  parent                 MenuItem?            @relation("MenuItemHierarchy", fields: [parentId], references: [id])
  children               MenuItem[]           @relation("MenuItemHierarchy")
  menuItemPermissions    MenuItemPermission[]

  @@index([parentId])
  @@index([isActive])
}

model MenuItemPermission {
  id           String     @id @default(cuid())
  menuItemId   String
  permissionId String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, permissionId])
  @@index([menuItemId])
  @@index([permissionId])
}

model FeatureFlag {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  enabled          Boolean          @default(false)
  scope            FeatureFlagScope
  requiresApproval Boolean          @default(false)
  createdAt        DateTime         @default(now())
  createdBy        String?
  updatedAt        DateTime         @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  @@index([name])
  @@index([enabled])
  @@index([scope])
  @@index([deletedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String?
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  timestamp    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

model Event {
  id           String      @id @default(cuid())
  eventName    String
  payload      Json
  userId       String?
  resourceType String?
  resourceId   String?
  status       EventStatus @default(PENDING)
  processedAt  DateTime?
  timestamp    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id])

  @@index([eventName])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([status])
  @@index([timestamp])
}

/// [FIX 4] Moyasar payout / balance transfer webhook audit trail (no booking link required)
model MoyasarPayoutWebhookRecord {
  id                String   @id @default(cuid())
  moyasarResourceId String   @unique
  eventClass        String
  eventType         String
  amountHalalah     Int?
  currency          String?  @default("SAR")
  failureReason     String?
  rawPayload        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventType])
  @@index([eventClass])
}

model Vendor {
  id             String         @id @default(cuid())
  userId         String         @unique
  companyName    String
  companyNameAr  String?
  slug           String         @unique
  logo           String?
  description    String?
  phone          String?
  email          String?
  commercialReg  String?
  vatNumber      String?
  bankName       String?
  iban           String?
  commissionRate Decimal        @db.Decimal(5, 2)
  status         VendorStatus   @default(PENDING)
  isNameVisible  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  createdBy      String?
  updatedAt      DateTime       @updatedAt
  updatedBy      String?
  approvedAt     DateTime?
  approvedBy     String?
  deletedAt      DateTime?
  deletedBy      String?
  equipment      Equipment[]
  user           User           @relation(fields: [userId], references: [id])
  payouts        VendorPayout[]

  @@index([status])
  @@index([slug])
  @@index([userId])
  @@index([deletedAt])
}

model VendorPayout {
  id               String        @id @default(cuid())
  vendorId         String
  bookingId        String?
  periodStart      DateTime?
  periodEnd        DateTime?
  grossAmount      Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  netAmount        Decimal       @db.Decimal(10, 2)
  status           PayoutStatus  @default(PENDING)
  paidAt           DateTime?
  bankRef          String?
  notes            String?
  createdAt        DateTime      @default(now())
  createdBy        String?
  updatedAt        DateTime      @updatedAt
  ledgerEntries    LedgerEntry[]
  vendor           Vendor        @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([bookingId])
}

model Category {
  id                     String                  @id @default(cuid())
  name                   String
  nameAr                 String?
  nameEn                 String?
  nameZh                 String?
  nameFr                 String?
  slug                   String                  @unique
  description            String?
  parentId               String?
  isActive               Boolean                 @default(true)
  sortOrder              Int                     @default(0)
  createdAt              DateTime                @default(now())
  createdBy              String?
  updatedAt              DateTime                @updatedAt
  updatedBy              String?
  deletedAt              DateTime?
  deletedBy              String?
  parent                 Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children               Category[]              @relation("CategoryHierarchy")
  equipment              Equipment[]
  products               Product[]               @relation("ProductCategory")
  subProducts            Product[]               @relation("ProductSubCategory")
  shootTypeCategoryFlows ShootTypeCategoryFlow[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Brand {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  logo        String?
  createdAt   DateTime    @default(now())
  createdBy   String?
  updatedAt   DateTime    @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?
  equipment   Equipment[]
  products    Product[]

  @@index([slug])
  @@index([deletedAt])
}

model Equipment {
  id                       String                    @id @default(cuid())
  sku                      String                    @unique
  model                    String?
  categoryId               String
  brandId                  String?
  condition                EquipmentCondition        @default(GOOD)
  quantityTotal            Int                       @default(1)
  quantityAvailable        Int                       @default(1)
  dailyPrice               Decimal                   @db.Decimal(10, 2)
  weeklyPrice              Decimal?                  @db.Decimal(10, 2)
  monthlyPrice             Decimal?                  @db.Decimal(10, 2)
  featured                 Boolean                   @default(false)
  isActive                 Boolean                   @default(true)
  warehouseLocation        String?
  barcode                  String?
  specifications           Json?
  customFields             Json?
  createdAt                DateTime                  @default(now())
  createdBy                String?
  updatedAt                DateTime                  @updatedAt
  updatedBy                String?
  deletedAt                DateTime?
  deletedBy                String?
  vendorId                 String?
  budgetTier               BudgetTier?
  productId                String?                   @unique
  slug                     String?                   @unique
  aiSuggestions            Json?
  specBlacklist            Json?
  specConfidence           Float?
  specLastInferredAt       DateTime?
  specSource               String?
  rentalCycles             Int                       @default(0)
  maxCyclesBeforeService   Int                       @default(50)
  lastServiceDate          DateTime?
  needsService             Boolean                   @default(false)
  nameEn                   String?
  nameZh                   String?
  descriptionEn            String?
  descriptionZh            String?
  purchasePrice            Decimal?                  @db.Decimal(10, 2)
  requiresAssistant        Boolean                   @default(false)
  bookings                 BookingEquipment[]
  cartItems                CartItem[]
  damageClaims             DamageClaim[]
  brand                    Brand?                    @relation(fields: [brandId], references: [id])
  category                 Category                  @relation(fields: [categoryId], references: [id])
  product                  Product?                  @relation(fields: [productId], references: [id])
  vendor                   Vendor?                   @relation(fields: [vendorId], references: [id])
  inspections              Inspection[]
  kitEquipment             KitEquipment[]
  maintenance              Maintenance[]
  media                    Media[]
  quoteEquipment           QuoteEquipment[]
  savedByUsers             SavedEquipment[]
  shootTypeRecommendations ShootTypeRecommendation[]
  warehouseScans           WarehouseScan[]
  stocks                   EquipmentStock[]
  waitlistEntries          WaitlistEntry[]

  @@index([sku])
  @@index([slug])
  @@index([productId])
  @@index([categoryId])
