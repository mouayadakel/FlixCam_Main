/// Customer waitlist for equipment availability (public /api/waitlist + cron expiry)
model WaitlistEntry {
  id               String    @id @default(cuid())
  equipmentId      String
  userId           String?
  guestEmail       String?
  desiredStartDate DateTime
  desiredEndDate   DateTime
  desiredQty       Int       @default(1)
  status           String    @default("WAITING")
  expiresAt        DateTime
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([equipmentId, status])
  @@index([userId])
  @@index([guestEmail])
  @@index([expiresAt])
}

model WarehouseScan {
  id          String            @id @default(cuid())
  bookingId   String
  equipmentId String
  type        WarehouseScanType
  barcode     String
  scannedBy   String
  createdAt   DateTime          @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [scannedBy], references: [id])

  @@index([bookingId])
  @@index([equipmentId])
  @@index([barcode])
  @@index([scannedBy])
}

model Warehouse {
  id         String           @id @default(cuid())
  name       String
  city       String
  address    String
  managerId  String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  stocks     EquipmentStock[]
  manager    User?            @relation("WarehouseManager", fields: [managerId], references: [id])
  bookings   Booking[]
  deliveries Delivery[]

  @@index([city])
}

model EquipmentStock {
  id          String    @id @default(cuid())
  equipmentId String
  warehouseId String
  quantity    Int       @default(0)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([equipmentId, warehouseId])
  @@index([equipmentId])
  @@index([warehouseId])
}

model ChatConversation {
  id            String        @id @default(cuid())
  sessionId     String
  channel       String        @default("public")
  userId        String?
  handoverAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]

  @@index([sessionId])
  @@index([userId])
  @@index([channel])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model ChatbotSettings {
  id          String   @id @default("global")
  greetingAr  String?
  greetingEn  String?
  tone        String   @default("professional")
  companyName String?
  faqEntries  Json?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
